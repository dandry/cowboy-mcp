#: admin/class-mcp-admin-connections.php:350
#: admin/class-mcp-admin-connections.php:396
#: admin/class-mcp-admin-connections.php:715
msgid "Approve access"
msgstr "Подтвердите доступ"

#: admin/class-mcp-admin-connections.php:353
